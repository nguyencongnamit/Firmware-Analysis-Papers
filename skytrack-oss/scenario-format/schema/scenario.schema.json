{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sn360.dev/schemas/scenario/0.1.0/scenario.schema.json",
  "title": "SkyTrack Scenario",
  "description": "Portable, versioned interchange format for drone/robot test scenarios.",
  "type": "object",
  "required": ["scenario_version", "name", "world", "agents"],
  "additionalProperties": false,
  "properties": {
    "scenario_version": {
      "type": "string",
      "description": "Semantic version of the scenario schema this file targets.",
      "pattern": "^0\\.1\\.[0-9]+$"
    },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "seed": {
      "type": "integer",
      "description": "Deterministic RNG seed; everything needed to replay is in this file.",
      "minimum": 0
    },
    "world": {
      "type": "object",
      "required": ["origin", "environment"],
      "additionalProperties": false,
      "properties": {
        "origin": {
          "type": "object",
          "required": ["lat", "lon", "alt"],
          "additionalProperties": false,
          "properties": {
            "lat": { "type": "number", "minimum": -90, "maximum": 90 },
            "lon": { "type": "number", "minimum": -180, "maximum": 180 },
            "alt": { "type": "number", "description": "Origin altitude in meters AMSL." }
          }
        },
        "environment": { "$ref": "#/$defs/environment" }
      }
    },
    "agents": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/agent" }
    },
    "faults": {
      "type": "array",
      "description": "Injected faults, each with a trigger and a duration.",
      "items": { "$ref": "#/$defs/fault" }
    },
    "success_criteria": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/criterion" }
    }
  },
  "$defs": {
    "vec3": {
      "type": "array",
      "items": { "type": "number" },
      "minItems": 3,
      "maxItems": 3
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "wind": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mean_mps": { "$ref": "#/$defs/vec3" },
            "gust_mps": { "type": "number", "minimum": 0 },
            "gust_period_s": { "type": "number", "exclusiveMinimum": 0 }
          }
        },
        "gps_quality": {
          "type": "string",
          "enum": ["nominal", "degraded", "denied"]
        },
        "time_of_day_s": { "type": "number", "minimum": 0, "maximum": 86400 }
      }
    },
    "agent": {
      "type": "object",
      "required": ["id", "body", "start", "mission"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "body": {
          "type": "string",
          "description": "Body archetype the brain runs on.",
          "enum": ["multirotor", "fixed_wing", "ground_robot"]
        },
        "start": {
          "type": "object",
          "required": ["position"],
          "additionalProperties": false,
          "properties": {
            "position": { "$ref": "#/$defs/vec3" },
            "heading_deg": { "type": "number" }
          }
        },
        "mission": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/mission_step" }
        }
      }
    },
    "mission_step": {
      "type": "object",
      "required": ["action"],
      "additionalProperties": false,
      "properties": {
        "action": {
          "type": "string",
          "enum": ["takeoff", "goto", "hover", "land", "follow", "return_home"]
        },
        "target": { "$ref": "#/$defs/vec3" },
        "duration_s": { "type": "number", "exclusiveMinimum": 0 },
        "speed_mps": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "fault": {
      "type": "object",
      "required": ["type", "trigger"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "enum": ["sensor_dropout", "gps_denied", "wind_gust", "motor_loss", "comms_loss"]
        },
        "target": { "type": "string", "description": "Agent id or sensor name affected." },
        "trigger": {
          "type": "object",
          "required": ["at_s"],
          "additionalProperties": false,
          "properties": { "at_s": { "type": "number", "minimum": 0 } }
        },
        "duration_s": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "criterion": {
      "type": "object",
      "required": ["id", "type"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "type": {
          "type": "string",
          "enum": ["reach_waypoint", "stay_within_geofence", "land_within_radius", "no_crash", "max_mission_time"]
        },
        "agent": { "type": "string" },
        "target": { "$ref": "#/$defs/vec3" },
        "radius_m": { "type": "number", "exclusiveMinimum": 0 },
        "limit_s": { "type": "number", "exclusiveMinimum": 0 }
      }
    }
  }
}
